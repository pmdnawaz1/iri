{
  "name": "rir",
  "version": "0.0.0",
  "private": true,
  "description": "Repository Intermediate Representation (RIR) — a Software Knowledge Compiler",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b && tsc -p eos/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "rir": "node --import tsx apps/cli/src/index.ts",
    "eos:compile": "tsx eos/compiler/compile.ts",
    "eos:prompts": "tsx eos/compiler/make-prompts.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "tree-sitter",
      "tree-sitter-go"
    ]
  }
}
