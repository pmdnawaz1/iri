    "@rir/storage": "workspace:*",
    "@rir/closure": "workspace:*",
    "@rir/consistency": "workspace:*",
    "@rir/coverage": "workspace:*",
    "@rir/query-engine": "workspace:*",
    "@rir/graph": "workspace:*",
    "@rir/compiler": "workspace:*",
    "@rir/common": "workspace:*",
    "typescript": "^5.7.2"
  }
}
